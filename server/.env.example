# --- Core ---
NODE_ENV=development
PORT=4000
MONGODB_URI=mongodb://127.0.0.1:27017/campusflow
# Required in production. Generate with: node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
JWT_SECRET=
JWT_EXPIRES_IN=7d
CORS_ORIGINS=http://localhost:5173

# --- Collection ---
COLLECTION_DATASET_ID=nitrr-campus-collected
DEFAULT_SAMPLING_INTERVAL_SECONDS=5
MIN_SAMPLING_INTERVAL_SECONDS=1
MAX_SAMPLING_INTERVAL_SECONDS=60
MAX_BATCH_SIZE=500
CLOCK_SKEW_SECONDS=300
MAX_ACCURACY_METERS=10000
MAX_SPEED_MPS=100
# Optional "minLon,minLat,maxLon,maxLat". Set ONLY from a verified campus boundary.
# When set, points outside it are rejected and never stored.
STUDY_AREA_BBOX=

# --- Privacy ---
RETENTION_DAYS=365
# Shared with the Python analysis (npm run analyze).
MIN_AGGREGATE_PARTICIPANTS=3
CONSENT_VERSION=1.0
STUDY_CONTACT=
ETHICS_APPROVAL_REF=

# --- Rate limits ---
RATE_LIMIT_GLOBAL_PER_MINUTE=1200
RATE_LIMIT_AUTH_PER_15_MIN=30
RATE_LIMIT_COLLECTION_PER_MINUTE=120

# --- Synthetic seed (development only) ---
# Arbitrary origin for fictional places; NOT a verified campus coordinate.
SYNTHETIC_ORIGIN=21.2500,81.6050
