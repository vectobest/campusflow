# Where the API lives. Leave both unset in development: Vite proxies /api to the local server.
# Separate deployment: set ONE of these at build time.
VITE_API_BASE_URL=          # full URL, e.g. https://campusflow-api.onrender.com/api/v1
VITE_API_HOST=              # host only, e.g. campusflow-api.onrender.com (Render blueprint sets this)
# Dev proxy target (default http://localhost:4000)
VITE_API_PROXY=
